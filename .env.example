# Postgres connection string от Neon или Supabase (с включённым pgvector)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Ключ Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Модель Gemini (Flash-Lite — самая дешёвая/быстрая, подходит для короткой саммаризации)
GEMINI_MODEL=gemini-flash-lite-latest

# Сколько дней хранить новости перед удалением
RETENTION_DAYS=7

# Порог косинусной похожести для склейки новостей в один кластер (0-1, чем выше — тем строже)
DEDUPE_THRESHOLD=0.75
