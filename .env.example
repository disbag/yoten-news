# Postgres с pgvector (Supabase)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Сайт: подпись куки сессии и домен/адрес для входа по passkey
SESSION_SECRET=
RP_ID=localhost
RP_ORIGIN=http://localhost:3000
# 1 — лента с тредами
THREADS_VIEW=1

# Сбор: ключи Google AI Studio (https://aistudio.google.com/apikey) через
# запятую — у каждого проекта своя бесплатная квота; модели — в порядке перебора
GEMINI_API_KEYS=AIza...,AIza...
GEMINI_MODELS=gemini-flash-lite-latest
# Запасная модель (https://console.groq.com/keys), необязательно
# GROQ_API_KEY=gsk_...

# Сколько дней хранить статьи и порог склейки по тексту (0–1)
RETENTION_DAYS=7
DEDUPE_THRESHOLD=0.75
