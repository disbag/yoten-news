# Postgres connection string от Neon или Supabase (с включённым pgvector)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Ключ(и) Google AI Studio — https://aistudio.google.com/apikey. Можно
# перечислить несколько через запятую (разные проекты Google AI Studio) —
# бесплатная квота считается per-project-per-model, так что каждый даёт
# независимый лимит запросов; src/lib/gemini.ts сам переключается на
# следующий при "лимит исчерпан" (429), без ручного вмешательства.
GEMINI_API_KEYS=AIza...,AIza...

# Модель(и) Gemini через запятую — перебор по порядку: сначала все ключи из
# GEMINI_API_KEYS пробуются на первой модели, потом (когда все исчерпаны) на
# следующей. Когда исчерпано всё, пайплайн (src/jobs/fetchAndProcess.ts)
# останавливается с ошибкой вместо бесконечных неудачных попыток (см. полный
# список моделей: curl https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEYS)
GEMINI_MODELS=gemini-flash-lite-latest

# Опционально: ключ Groq (https://console.groq.com/keys) как альтернативный
# провайдер — src/lib/groq.ts, переключается в src/lib/summarizer.ts
# GROQ_API_KEY=gsk_...

# Сколько дней хранить новости перед удалением
RETENTION_DAYS=7

# Порог косинусной похожести для склейки новостей в один кластер (0-1, чем выше — тем строже)
DEDUPE_THRESHOLD=0.75
